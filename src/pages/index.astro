<script>
  (function() {
    // Hero panel mode tabs
    const panelTabs = document.querySelectorAll('.panel-tab');
    const panelViews = document.querySelectorAll('.hero-view');

    if (panelTabs.length && panelViews.length) {
      function setPanelMode(mode) {
        panelTabs.forEach(t => {
          const active = t.getAttribute('data-hero-mode') === mode;
          t.classList.toggle('panel-tab--active', active);
          t.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        panelViews.forEach(v => {
          const active = v.getAttribute('data-hero-view') === mode;
          v.classList.toggle('hero-view--active', active);
        });
      }

      panelTabs.forEach(tab => {
        tab.addEventListener('click', () => setPanelMode(tab.getAttribute('data-hero-mode')));
      });

      // Hash handler: /#audit opens the Growth Audit view
      function applyHash() {
        const hash = (location.hash || '').replace('#', '').trim();
        if (hash === 'audit') {
          setPanelMode('form');
        }
      }
      applyHash();
      window.addEventListener('hashchange', applyHash);
    }

    // ROI calculator
    const spendSlider = document.getElementById('spend-slider');
    const affiliateSlider = document.getElementById('affiliate-slider');
    const spendVal = document.getElementById('spend-val');
    const affiliateVal = document.getElementById('affiliate-val');
    const projectedRev = document.getElementById('projected-rev');

    if (spendSlider && affiliateSlider && projectedRev) {
      function fmt(n) {
        if (n >= 1000000) return '$' + (n / 1000000).toFixed(2) + 'M';
        return '$' + n.toLocaleString('en-US');
      }

      function updateCalc() {
        const spend = parseInt(spendSlider.value, 10);
        const affPct = parseInt(affiliateSlider.value, 10);

        spendVal.textContent = '$' + spend.toLocaleString('en-US') + ' / mo';
        affiliateVal.textContent = affPct + '% of revenue';

        // PRL benchmark: 4.6x ROAS, 28% net incremental discovery reach
        const roas = 4.6;
        const discovery = 0.28;
        const gmv = spend * roas * (1 + discovery * (1 - affPct / 30));
        projectedRev.textContent = fmt(gmv);

        const roasNet = (gmv / spend).toFixed(2);
        const row = document.querySelector('.roi-outcome-row');
        if (row) {
          const mono = row.querySelector('.roi-outcome-mono');
          if (mono) mono.textContent = roasNet + 'x';
        }
      }

      updateCalc();
      spendSlider.addEventListener('input', updateCalc);
      affiliateSlider.addEventListener('input', updateCalc);
    }

    // Auth widget (legacy — kept for compatibility)
    const tabs = document.querySelectorAll('.auth-tab');
    const forms = document.querySelectorAll('.auth-form');

    if (tabs.length && forms.length) {
      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const target = tab.getAttribute('data-auth-tab');
          tabs.forEach(t => t.classList.remove('auth-tab--active'));
          tab.classList.add('auth-tab--active');
          forms.forEach(f => {
            f.style.display = f.getAttribute('data-auth-panel') === target ? 'block' : 'none';
          });
        });
      });

      document.querySelector('.auth-tab--active')?.click();

      forms.forEach(form => {
        form.addEventListener('submit', e => {
          e.preventDefault();
          const fine = form.querySelector('.auth-fine');
          const btn = form.querySelector('.auth-submit');
          if (btn) btn.textContent = 'Welcome aboard — check your inbox';
          if (fine) fine.textContent = 'Thanks! This is a demo widget — no data was sent.';
          form.querySelectorAll('input').forEach(i => { i.value = ''; });
        });
      });
    }
  })();
</script>
