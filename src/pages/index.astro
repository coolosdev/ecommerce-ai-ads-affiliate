---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Partner Revenue Labs — Online Marketing Agency";
const description = "We help up-and-coming brands, sponsorships, and brick-and-mortar retailers grow online through advertising packages across social, YouTube, live streaming, and marketplaces — with a dashboard to track every dollar.";
const canonical = "https://yourdomain.com/";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="container">
    <section class="hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-inner">
        <div class="hero-content">
          <div class="hero-eyebrow-pill">
            <span class="pulse-dot" aria-hidden="true"></span>
            <span>Full-Service Affiliate &amp; Performance Marketing</span>
          </div>
          <h1>
            We put your brand in front of the
            <span class="headline-accent">people who buy.
              <svg class="headline-underline" viewBox="0 0 200 8" fill="none" aria-hidden="true"><path d="M1 5.5C40 2 160 2 199 5.5" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
            </span>
          </h1>
          <p class="hero-subtitle">Up-and-coming brands, sponsorship deals, and retail powerhouses looking for real online reach — we build publisher partnerships, run high-converting performance media, and attribute every single dollar with mathematical precision.</p>
          <div class="hero-ctas">
            <a href="/services" class="cta-primary">
              <span>See Our Packages</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/contact" class="cta-secondary">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cta-secondary-icon"><path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <span>Book a Strategy Call</span>
            </a>
          </div>

          <div class="hero-metrics">
            <div class="metric">
              <div class="metric-value">$140M+</div>
              <div class="metric-label">Attributed GMV</div>
            </div>
            <div class="metric">
              <div class="metric-value metric-value--accent">4.6x</div>
              <div class="metric-label">Avg Partner ROAS</div>
            </div>
            <div class="metric">
              <div class="metric-value">1,800+</div>
              <div class="metric-label">Vetted Publishers</div>
            </div>
          </div>

          <div class="hero-partner-line">
            <span class="partner-dot" aria-hidden="true"></span>
            <span>Premier Agency Partner: Impact.com · CJ Affiliate · Rakuten · Shopify Plus</span>
          </div>
        </div>

        <div class="hero-panel" id="audit">
          <div class="panel-tabs" role="tablist" aria-label="Hero panel view">
            <button type="button" class="panel-tab panel-tab--active" data-hero-mode="dashboard" role="tab" aria-selected="true">Live Telemetry</button>
            <button type="button" class="panel-tab" data-hero-mode="form" role="tab" aria-selected="false">Growth Audit</button>
            <button type="button" class="panel-tab" data-hero-mode="visual" role="tab" aria-selected="false">Network</button>
          </div>

          <div class="hero-view" data-hero-view="dashboard">
            <div class="glass-card">
              <div class="tel-head">
                <div class="tel-head-left">
                  <div class="tel-badge">PRL</div>
                  <div>
                    <h3 class="tel-title">Partner Revenue Engine&trade;
                      <span class="tel-live-tag">Live</span>
                    </h3>
                    <p class="tel-sub">Real-time omnichannel affiliate attribution</p>
                  </div>
                </div>
                <div class="tel-status">
                  <span class="tel-status-dot"></span>
                  <span>Tracking Active</span>
                </div>
              </div>

              <div class="tel-stats">
                <div class="tel-stat">
                  <span class="tel-stat-label">30-Day Partner GMV</span>
                  <div class="tel-stat-value">$482,910</div>
                  <div class="tel-stat-change">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                    <span>+32.4% vs last period</span>
                  </div>
                </div>
                <div class="tel-stat">
                  <span class="tel-stat-label">Blended Network ROAS</span>
                  <div class="tel-stat-value tel-stat-value--accent">5.18x</div>
                  <div class="tel-stat-note">Target benchmark: 3.20x</div>
                </div>
              </div>

              <div class="tel-chart">
                <div class="tel-chart-head">
                  <span class="tel-chart-title">Revenue Velocity Trend (Weekly)</span>
                  <div class="tel-legend">
                    <span><i class="dot dot--sage"></i>Affiliates</span>
                    <span><i class="dot dot--charcoal"></i>Paid Media</span>
                  </div>
                </div>
                <div class="tel-chart-body">
                  <svg viewBox="0 0 400 100" preserveAspectRatio="none" aria-hidden="true">
                    <defs>
                      <linearGradient id="sageGrad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#8CA388" stop-opacity="0.35"/>
                        <stop offset="100%" stop-color="#8CA388" stop-opacity="0"/>
                      </linearGradient>
                    </defs>
                    <line x1="0" y1="25" x2="400" y2="25" stroke="#f0efea" stroke-dasharray="3 3"/>
                    <line x1="0" y1="50" x2="400" y2="50" stroke="#f0efea" stroke-dasharray="3 3"/>
                    <line x1="0" y1="75" x2="400" y2="75" stroke="#f0efea" stroke-dasharray="3 3"/>
                    <polygon points="0,95 20,80 60,75 100,60 140,65 180,45 220,50 260,35 300,28 340,32 380,15 400,10 400,100 0,100" fill="url(#sageGrad)"/>
                    <polyline points="0,95 20,80 60,75 100,60 140,65 180,45 220,50 260,35 300,28 340,32 380,15 400,10" fill="none" stroke="#8CA388" stroke-width="2.5" stroke-linecap="round"/>
                    <circle cx="380" cy="15" r="4" fill="#8CA388" stroke="#ffffff" stroke-width="2"/>
                  </svg>
                </div>
              </div>

              <div class="tel-channels">
                <div class="tel-channels-label">Top Verified Growth Channels</div>
                <div class="tel-channels-grid">
                  <div class="tel-channel"><span class="tel-channel-name">Tech Review Portals</span><span class="tel-channel-meta">$204k GMV (42%)</span></div>
                  <div class="tel-channel"><span class="tel-channel-name">Creator Deals</span><span class="tel-channel-meta">$151k GMV (31%)</span></div>
                  <div class="tel-channel"><span class="tel-channel-name">CSS Shopping Ads</span><span class="tel-channel-meta">$127k GMV (27%)</span></div>
                </div>
              </div>

              <div class="tel-ticker">
                <div class="tel-ticker-left">
                  <span class="tel-ticker-dot" aria-hidden="true"></span>
                  <span class="tel-ticker-text"><strong>Just Tracked:</strong> $1,420 order from Wirecutter Syndicate</span>
                </div>
                <span class="tel-ticker-time">1.8s ago</span>
              </div>

              <div class="tel-foot">
                <span class="tel-foot-item">
                  <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                  SOC-2 Type II Certified Attribution
                </span>
                <span class="tel-foot-strong">Trusted by 200+ High-Growth Brands</span>
              </div>
            </div>
          </div>

          <div class="hero-view" data-hero-view="form" hidden>
            <div class="glass-card">
              <div class="audit-head">
                <div class="audit-tabs">
                  <button type="button" class="audit-tab audit-tab--active" data-audit-tab="audit">Request Growth Audit</button>
                  <button type="button" class="audit-tab" data-audit-tab="portal">Client Portal</button>
                </div>
                <span class="audit-tag">Free 48h Analysis</span>
              </div>

              <div data-audit-panel="audit">
                <h3 class="audit-title">Audit your revenue potential</h3>
                <p class="audit-sub">Receive a custom forecast of incremental affiliate &amp; performance revenue.</p>
                <form class="audit-form" data-audit-form>
                  <div class="audit-field">
                    <label for="audit-revenue">Current Monthly Revenue</label>
                    <select id="audit-revenue">
                      <option>$50k - $250k / month (Scaling)</option>
                      <option selected>$250k - $1M / month (Growth Leader)</option>
                      <option>$1M - $5M+ / month (Enterprise)</option>
                    </select>
                  </div>
                  <div class="audit-row">
                    <div class="audit-field">
                      <label for="audit-name">Full Name</label>
                      <input id="audit-name" type="text" placeholder="Jordan Blake" autocomplete="name" />
                    </div>
                    <div class="audit-field">
                      <label for="audit-email">Work Email</label>
                      <input id="audit-email" type="email" placeholder="jordan@brand.com" autocomplete="email" />
                    </div>
                  </div>
                  <div class="audit-field">
                    <label for="audit-url">Brand Website or Store URL</label>
                    <input id="audit-url" type="text" placeholder="brandname.com" />
                  </div>
                  <button type="submit" class="audit-submit">
                    <span>Generate Custom Growth Audit</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                  </button>
                  <p class="audit-assurance">Strictly Confidential · Signed NDA on Request · 0% Obligation</p>
                </form>
              </div>

              <div data-audit-panel="portal" hidden>
                <h3 class="audit-title">Client portal</h3>
                <p class="audit-sub">Log in to view your live campaigns, ad spend, and attribution reports.</p>
                <form class="audit-form" data-audit-form>
                  <div class="audit-field">
                    <label for="portal-email">Work Email</label>
                    <input id="portal-email" type="email" placeholder="you@brand.com" autocomplete="email" />
                  </div>
                  <div class="audit-field">
                    <label for="portal-password">Password</label>
                    <input id="portal-password" type="password" placeholder="••••••••" autocomplete="current-password" />
                  </div>
                  <button type="submit" class="audit-submit">
                    <span>Log in to Dashboard</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                  </button>
                  <p class="audit-assurance">Trouble signing in? Contact your account manager.</p>
                </form>
              </div>
            </div>
          </div>

          <div class="hero-view" data-hero-view="visual" hidden>
            <div class="glass-card">
              <div class="visual-stage">
                <svg class="network-art" viewBox="0 0 400 250" fill="none" aria-hidden="true">
                  <path d="M40 200C100 120 150 180 210 90C260 20 320 70 370 30" stroke="#8CA388" stroke-width="2.5" stroke-linecap="round" opacity="0.7"/>
                  <path d="M30 90C110 140 170 60 230 140C290 210 340 150 380 190" stroke="#121316" stroke-width="2" stroke-linecap="round" opacity="0.25"/>
                  <path d="M60 40C140 80 200 40 260 90C320 130 360 100 390 120" stroke="#D92D20" stroke-width="2" stroke-linecap="round" opacity="0.5"/>
                  <circle cx="210" cy="90" r="9" fill="#8CA388" opacity="0.85"/>
                  <circle cx="210" cy="90" r="22" fill="#8CA388" opacity="0.18"/>
                  <circle cx="370" cy="30" r="6" fill="#121316" opacity="0.65"/>
                  <circle cx="30" cy="90" r="6" fill="#D92D20" opacity="0.8"/>
                  <circle cx="230" cy="140" r="7" fill="#8CA388" opacity="0.7"/>
                  <circle cx="390" cy="120" r="5" fill="#121316" opacity="0.5"/>
                  <circle cx="60" cy="40" r="5" fill="#D92D20" opacity="0.55"/>
                </svg>
                <div class="visual-overlay visual-overlay--tl">
                  <span class="visual-overlay-label">Network Reach</span>
                  <span class="visual-overlay-value">45M+ Shoppers / Mo</span>
                </div>
                <div class="visual-overlay visual-overlay--br">
                  <span class="visual-overlay-dot"></span>
                  <span>Live ROAS: 4.82x</span>
                </div>
              </div>
              <div class="visual-foot">
                <span>Visual Concept: &ldquo;The Organic Revenue Machine&rdquo;</span>
                <span class="visual-foot-accent">Clean Swiss B2B Aesthetic</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="partner-marquee" aria-label="Verified partner networks">
      <div class="partner-marquee-inner">
        <span class="partner-marquee-label">Trusted by growth teams across 200+ brands &amp; publishers</span>
        <div class="partner-logos">
          <span class="partner-logo"><i class="partner-logo-dot"></i>IMPACT.COM</span>
          <span class="partner-logo partner-logo--wide">CJ AFFILIATE</span>
          <span class="partner-logo partner-logo--sage">RAKUTEN ADVERTISING</span>
          <span class="partner-logo">SHOPIFY PLUS</span>
          <span class="partner-logo">AWIN NETWORK</span>
        </div>
      </div>
    </section>
  </div>

    <section class="roi-section" id="calculator">
      <div class="roi-intro">
        <span class="roi-eyebrow">Financial Impact Model</span>
        <h2>Calculate Your Incremental Partner Lift</h2>
        <p>See how much untapped GMV your brand can unlock by pairing performance affiliate architecture with PRL attribution.</p>
      </div>
      <div class="roi-card">
        <div class="roi-controls">
          <div class="roi-slider">
            <div class="roi-slider-head">
              <label>Monthly Ad &amp; Growth Budget</label>
              <span id="spend-val" class="roi-slider-value">$100,000 / mo</span>
            </div>
            <input type="range" id="spend-slider" min="20000" max="500000" step="10000" value="100000" oninput="updateCalc()" />
            <div class="roi-slider-ticks"><span>$20k</span><span>$250k</span><span>$500k+</span></div>
          </div>
          <div class="roi-slider">
            <div class="roi-slider-head">
              <label>Current Affiliate Channel Contribution</label>
              <span id="affiliate-val" class="roi-slider-value">10% of revenue</span>
            </div>
            <input type="range" id="affiliate-slider" min="0" max="30" step="5" value="10" oninput="updateCalc()" />
            <div class="roi-slider-ticks"><span>0% (None)</span><span>15% (Moderate)</span><span>30%+ (Mature)</span></div>
          </div>
          <div class="roi-note">
            <span class="roi-note-title">PRL Benchmark Assumption:</span>
            <span>Average vetted affiliate ROAS of 4.6x with 28% net incremental discovery reach.</span>
          </div>
        </div>
        <div class="roi-outcome">
          <div class="roi-outcome-label">Projected 12-Month GMV</div>
          <div id="projected-rev" class="roi-outcome-value">$1,840,000</div>
          <div class="roi-outcome-sub">Estimated verified gross sales</div>
          <div class="roi-outcome-row">
            <span>Net Return On Ad Spend:</span>
            <span class="roi-outcome-mono">4.62x</span>
          </div>
          <div class="roi-outcome-row">
            <span>New High-Tier Publishers:</span>
            <span class="roi-outcome-mono">40 - 75 Active</span>
          </div>
          <a href="/#audit" class="roi-cta">
            <span>Lock In This Projection</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>
      </div>
    </section>

    <section class="channels-section">
      <div class="section-intro">
        <span class="section-eyebrow">WHERE WE PUT YOUR BRAND</span>
        <h2>Exposure across the channels your customers live in</h2>
        <p>From social feeds to live shopping events and marketplace placements, we meet buyers where they already are.</p>
      </div>
      <div class="channels-grid">
        <div class="channel-card">
          <div class="channel-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 3.9"/><path d="m15.4 6.6-6.8 3.9"/></svg>
          </div>
          <h3>Social Media</h3>
          <p>Instagram, TikTok, and X campaigns that build audience, demand, and brand recall.</p>
        </div>
        <div class="channel-card">
          <div class="channel-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="4"/><polygon points="10 9 15 12 10 15 10 9"/></svg>
          </div>
          <h3>YouTube</h3>
          <p>Pre-roll, creator integrations, and product features that turn viewers into buyers.</p>
        </div>
        <div class="channel-card">
          <div class="channel-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="2"/><path d="M4.9 19.1a10 10 0 0 1 0-14.2"/><path d="M19.1 4.9a10 10 0 0 1 0 14.2"/><path d="M7.8 16.2a6 6 0 0 1 0-8.4"/><path d="M16.2 7.8a6 6 0 0 1 0 8.4"/></svg>
          </div>
          <h3>Live Streaming</h3>
          <p>Twitch, Kick, and TikTok Live activations that drive real-time engagement and sales.</p>
        </div>
        <div class="channel-card">
          <div class="channel-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          </div>
          <h3>Whatnot</h3>
          <p>Live shopping events and giveaway drops that convert viewers into repeat buyers.</p>
        </div>
        <div class="channel-card">
          <div class="channel-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg>
          </div>
          <h3>Amazon</h3>
          <p>Sponsored Products, storefronts, and listing optimization that win the buy box.</p>
        </div>
        <div class="channel-card">
          <div class="channel-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41 13.42 20.6a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82Z"/><circle cx="7" cy="7" r="1.5"/></svg>
          </div>
          <h3>eBay</h3>
          <p>Marketplace presence and promoted listings that extend your reach beyond your own site.</p>
        </div>
      </div>
    </section>

    <section class="packages-section">
      <div class="section-intro">
        <span class="section-eyebrow">ADVERTISING PACKAGES</span>
        <h2>Pick a package. We handle the rest.</h2>
        <p>Clear scope, transparent ad spend, and a dashboard that shows exactly where your money goes.</p>
      </div>
      <div class="packages-grid">
        <div class="package-card">
          <h3>Launch</h3>
          <p class="package-for">For up-and-coming brands getting their first real reach.</p>
          <ul>
            <li>2 channels of your choice</li>
            <li>Monthly content calendar</li>
            <li>Campaign setup &amp; management</li>
            <li>Access to the analytics dashboard</li>
          </ul>
          <a href="/services" class="package-cta">Start with Launch</a>
        </div>
        <div class="package-card package-card--featured">
          <span class="package-badge">Most Popular</span>
          <h3>Scale</h3>
          <p class="package-for">For growing brands ready to own their niche across channels.</p>
          <ul>
            <li>4 channels of your choice</li>
            <li>Creator &amp; sponsorship outreach</li>
            <li>Weekly optimization &amp; reporting</li>
            <li>Full dashboard + ad spend tracking</li>
          </ul>
          <a href="/services" class="package-cta">Scale Your Reach</a>
        </div>
        <div class="package-card">
          <h3>Dominate</h3>
          <p class="package-for">For brick-and-mortar retailers building a full online presence.</p>
          <ul>
            <li>All channels, fully managed</li>
            <li>Dedicated account manager</li>
            <li>Custom dashboards &amp; budgets</li>
            <li>Marketplace + live shopping builds</li>
          </ul>
          <a href="/services" class="package-cta">Build Your Presence</a>
        </div>
      </div>
    </section>

    <section class="dashboard-preview-section">
      <div class="dashboard-preview-content">
        <span class="section-eyebrow">YOUR NUMBERS, LIVE</span>
        <h2>A dashboard that makes ad spend make sense.</h2>
        <p>Every campaign, channel, and dollar in one place — impressions, clicks, conversions, ROAS, and spend, updated as it happens.</p>
        <a href="/contact" class="cta-primary">Book a Free Strategy Call</a>
      </div>
      <div class="dashboard-mock">
        <div class="mock-header">
          <span class="mock-dot mock-dot--red"></span>
          <span class="mock-dot mock-dot--amber"></span>
          <span class="mock-dot mock-dot--green"></span>
          <span class="mock-title">Campaign Overview</span>
        </div>
        <div class="mock-stats">
          <div class="mock-stat">
            <span class="mock-label">Ad Spend</span>
            <span class="mock-value">$24,180</span>
            <span class="mock-change mock-change--up">+12.4%</span>
          </div>
          <div class="mock-stat">
            <span class="mock-label">ROAS</span>
            <span class="mock-value">4.2x</span>
            <span class="mock-change mock-change--up">+0.6x</span>
          </div>
          <div class="mock-stat">
            <span class="mock-label">Conversions</span>
            <span class="mock-value">1,842</span>
            <span class="mock-change mock-change--up">+18.2%</span>
          </div>
        </div>
        <div class="mock-chart">
          <div class="mock-bar" style="height: 40%"></div>
          <div class="mock-bar" style="height: 55%"></div>
          <div class="mock-bar" style="height: 35%"></div>
          <div class="mock-bar" style="height: 70%"></div>
          <div class="mock-bar" style="height: 60%"></div>
          <div class="mock-bar" style="height: 85%"></div>
