---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const title = "Partner Revenue Labs";
const description = "AI-powered advertising and analytics tools for ecommerce brands.";
const canonical = "https://yourdomain.com/";

const posts = await getCollection("blog");
const sorted = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const featured = sorted.find((p) => p.data.featured) ?? sorted[0];
const recent = sorted.filter((p) => p.slug !== featured?.slug);
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="container">
    <section class="hero">
      <div class="hero-bg-glow"></div>
      <div class="hero-content">
        <span class="hero-eyebrow">ECOMMERCE ADVERTISING & ANALYTICS</span>
        <h1>Partner Revenue Labs</h1>
        <p class="hero-subtitle">Actionable guides and tools for ecommerce brands using AI in ads and analytics — so you can reclaim time and grow revenue.</p>
        <div class="hero-ctas">
          <a href="/blog" class="cta-primary">Explore Our Guides</a>
          <a href="/contact" class="cta-secondary">Get in Touch</a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="visual-card">
          <div class="visual-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          </div>
          <h3>AI-Powered</h3>
          <p>Smarter ads, better ROI</p>
        </div>
        <div class="visual-card">
          <div class="visual-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 14l3-3 3 3 5-6"/></svg>
          </div>
          <h3>Data-Driven</h3>
          <p>Insights that matter</p>
        </div>
        <div class="visual-card">
          <div class="visual-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </div>
          <h3>Fast Setup</h3>
          <p>Launch in minutes</p>
        </div>
      </div>
    </section>

    {featured ? (
      <section class="featured-section">
        <h2>Featured Article</h2>
        <article class="featured-card">
          <div class="featured-image">
            <span class="featured-tag">Featured</span>
            {featured.data.heroImage ? (
              <img src={featured.data.heroImage} alt={featured.data.title} loading="eager" class="featured-img" />
            ) : (
              <div class="image-placeholder">🚀</div>
            )}
          </div>
          <div class="featured-content">
            <h3><a href={`/blog/${featured.slug}`}>{featured.data.title}</a></h3>
            <p>{featured.data.description}</p>
            <div class="featured-meta">
              <time>{featured.data.pubDate.toDateString()}</time>
              {featured.data.tags && featured.data.tags.length > 0 && (
                <span class="tags">
                  {featured.data.tags.slice(0, 3).map((tag: string) => (
                    <span class="tag">{tag}</span>
                  ))}
                </span>
              )}
            </div>
          </div>
        </article>
      </section>
    ) : null}

    {recent.length > 0 && (
      <section class="recent-section">
        <div class="section-header">
          <h2>Recent Guides</h2>
          <a href="/blog" class="view-all">View All →</a>
        </div>
        <div class="recent-grid">
          {recent.slice(0, 6).map((post) => (
            <article class="post-card" key={post.slug}>
              <div class="post-card-image">
                {post.data.heroImage ? (
                  <img src={post.data.heroImage} alt={post.data.title} loading="lazy" class="post-card-img" />
                ) : (
                  <div class="image-placeholder-sm">
                    {post.data.tags?.[0]?.charAt(0)?.toUpperCase() || '📝'}
                  </div>
                )}
              </div>
              <div class="post-card-content">
                <h3><a href={`/blog/${post.slug}`}>{post.data.title}</a></h3>
                <p>{post.data.description?.slice(0, 100)}...</p>
                <time>{post.data.pubDate.toDateString()}</time>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Hero Section */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding: 5rem 0 4rem;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg-glow {
    position: absolute;
    inset: -40% -20% auto -20%;
    height: 120%;
    background:
      radial-gradient(circle at 15% 30%, rgba(16, 185, 129, 0.10), transparent 45%),
      radial-gradient(circle at 85% 20%, rgba(212, 43, 43, 0.10), transparent 45%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-content,
  .hero-visual {
    position: relative;
    z-index: 1;
  }

  @media (min-width: 768px) {
    .hero {
      grid-template-columns: 1.5fr 1fr;
      padding: 6rem 0;
    }
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }

  .hero h1 {
    font-size: 2.75rem;
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, #ffffff 30%, #6ee7b7 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: var(--text);
    margin-bottom: 1.25rem;
  }

  @media (min-width: 768px) {
    .hero h1 {
      font-size: 3.75rem;
    }
  }

  .hero-subtitle {
    font-size: 1.125rem;
    color: #cbd5e1;
    margin-bottom: 2.25rem;
    line-height: 1.65;
    max-width: 30rem;
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cta-primary {
    background: var(--accent);
    color: #022c22;
    padding: 0.9rem 1.75rem;
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 700;
    transition: all 0.2s;
    box-shadow: 0 4px 20px rgba(16, 185, 129, 0.25);
  }

  .cta-primary:hover {
    transform: translateY(-2px);
    background: var(--accent-hover);
    box-shadow: 0 6px 26px rgba(16, 185, 129, 0.35);
  }

  .cta-secondary {
    color: var(--text);
    padding: 0.9rem 1.75rem;
    border: 2px solid var(--border-hover);
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s;
  }

  .cta-secondary:hover {
    background: var(--surface-elev);
    border-color: var(--text-secondary);
    color: var(--text);
  }

  .hero-visual {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .visual-card {
    background: linear-gradient(160deg, var(--surface-elev) 0%, var(--surface) 100%);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 1.5rem 1rem;
    border-radius: var(--radius);
    text-align: center;
    transition: all 0.25s;
  }

  .visual-card:hover {
    border-color: rgba(16, 185, 129, 0.45);
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(2, 6, 23, 0.6);
  }

  .visual-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    margin: 0 auto 1rem;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.12);
    color: var(--accent);
  }

  .visual-card h3 {
    font-size: 0.9375rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
    color: #f1f5f9;
  }

  .visual-card p {
    font-size: 0.8125rem;
    color: #94a3b8;
    line-height: 1.4;
  }

  /* Featured Section */
  .featured-section {
    padding: 3rem 0;
  }

  .featured-section h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: var(--text);
  }

  .featured-card {
    display: grid;
    grid-template-columns: 1fr;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: all 0.2s;
  }

  @media (min-width: 768px) {
    .featured-card {
      grid-template-columns: 2fr 3fr;
    }
  }

  .featured-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .featured-image {
    background: var(--surface-elev);
    min-height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .featured-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .featured-tag {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: var(--accent);
    color: #ffffff;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .image-placeholder {
    font-size: 4rem;
    opacity: 0.3;
  }

  .featured-content {
    padding: 2rem;
  }

  .featured-content h3 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }

  .featured-content h3 a {
    color: inherit;
    text-decoration: none;
  }

  .featured-content h3 a:hover {
    color: var(--accent);
  }

  .featured-content p {
    color: var(--muted);
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .featured-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    background: var(--surface-elev);
    color: var(--text);
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 500;
  }

  /* Recent Section */
  .recent-section {
    padding: 3rem 0;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
  }

  .section-header h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text);
  }

  .view-all {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.875rem;
    transition: all 0.2s;
  }

  .view-all:hover {
    color: var(--accent-hover);
  }

  .recent-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .recent-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .recent-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .post-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: all 0.2s;
  }

  .post-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .post-card-image {
    height: 160px;
    background: var(--surface-elev);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .post-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s;
  }

  .post-card:hover .post-card-img {
    transform: scale(1.05);
  }

  .image-placeholder-sm {
    font-size: 3rem;
    opacity: 0.3;
  }

  .post-card-content {
    padding: 1.25rem;
  }

  .post-card-content h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .post-card-content h3 a {
    color: inherit;
    text-decoration: none;
  }

  .post-card-content h3 a:hover {
    color: var(--accent);
  }

  .post-card-content p {
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }

  .post-card-content time {
    color: var(--muted);
    font-size: 0.75rem;
  }
</style>