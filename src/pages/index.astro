---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Partner Revenue Labs — Online Marketing Agency";
const description = "We help up-and-coming brands, sponsorships, and brick-and-mortar retailers grow online through advertising packages across social, YouTube, live streaming, and marketplaces — with a dashboard to track every dollar.";
const canonical = "https://yourdomain.com/";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="container">
    <section class="hero">
      <div class="hero-bg-image" aria-hidden="true"></div>
      <div class="hero-bg-wash" aria-hidden="true"></div>
      <div class="hero-inner">
      <div class="hero-content">
        <span class="hero-eyebrow">FULL-SERVICE ONLINE MARKETING AGENCY</span>
        <h1>We put your brand in front of the people who buy.</h1>
        <p class="hero-subtitle">Up-and-coming brands, sponsorship deals, and brick-and-mortar retailers looking for real online reach — we build the exposure, run the ads, and track every dollar.</p>
        <div class="hero-ctas">
          <a href="/services" class="cta-primary">See Our Packages</a>
          <a href="/contact" class="cta-secondary">Book a Call</a>
        </div>
      </div>
      <div class="hero-auth">
        <div class="auth-card">
          <div class="auth-tabs" role="tablist" aria-label="Account access">
            <button type="button" class="auth-tab auth-tab--active" data-auth-tab="signup" role="tab" aria-selected="true">Sign up</button>
            <button type="button" class="auth-tab" data-auth-tab="login" role="tab" aria-selected="false">Log in</button>
          </div>

          <form class="auth-form" data-auth-panel="signup">
            <h2>Start your free trial</h2>
            <p class="auth-sub">Dashboard access, package tracking, and campaign reports.</p>
            <label for="signup-name">Full name</label>
            <input id="signup-name" name="name" type="text" placeholder="Jordan Blake" autocomplete="name" required />
            <label for="signup-email">Work email</label>
            <input id="signup-email" name="email" type="email" placeholder="you@brand.com" autocomplete="email" required />
            <label for="signup-password">Create password</label>
            <input id="signup-password" name="password" type="password" placeholder="At least 8 characters" autocomplete="new-password" required minlength="8" />
            <button type="submit" class="auth-submit">Create my account</button>
            <p class="auth-fine">No card required · 14-day free trial</p>
          </form>

          <form class="auth-form" data-auth-panel="login" hidden>
            <h2>Welcome back</h2>
            <p class="auth-sub">Log in to see your campaigns and ad spend.</p>
            <label for="login-email">Email</label>
            <input id="login-email" name="email" type="email" placeholder="you@brand.com" autocomplete="email" required />
            <label for="login-password">Password</label>
            <input id="login-password" name="password" type="password" placeholder="••••••••" autocomplete="current-password" required />
            <button type="submit" class="auth-submit">Log in</button>
            <p class="auth-fine">Trouble signing in? Contact your account manager.</p>
          </form>
        </div>
        <p class="auth-social">Trusted by 200+ growing brands</p>
      </div>
      </div>
    </section>

    <section class="hero-trust" aria-label="Why Partner Revenue Labs">
      <div class="visual-card">
        <div class="visual-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/><path d="M6 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/><path d="M18 22a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/><path d="m8.6 13.5 6.8 3.9"/><path d="m15.4 6.6-6.8 3.9"/></svg>
        </div>
        <h3>Omnichannel</h3>
        <p>Every channel, one strategy</p>
      </div>
      <div class="visual-card">
        <div class="visual-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 14l3-3 3 3 5-6"/></svg>
        </div>
        <h3>Tracked</h3>
        <p>Ad spend you can see</p>
      </div>
      <div class="visual-card">
        <div class="visual-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        </div>
        <h3>Fast Launch</h3>
        <p>Live in weeks, not months</p>
      </div>
    </section>

    <section class="channels-section">
      <div class="section-intro">
        <span class="section-eyebrow">WHERE WE PUT YOUR BRAND</span>
        <h2>Exposure across the channels your customers live in</h2>
        <p>From social feeds to live shopping events and marketplace placements, we meet buyers where they already are.</p>
      </div>
      <div class="channels-grid">
        <div class="channel-card">
          <div class="channel-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 3.9"/><path d="m15.4 6.6-6.8 3.9"/></svg>
          </div>
          <h3>Social Media</h3>
          <p>Instagram, TikTok, and X campaigns that build audience, demand, and brand recall.</p>
        </div>
        <div class="channel-card">
          <div class="channel-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="4"/><polygon points="10 9 15 12 10 15 10 9"/></svg>
          </div>
          <h3>YouTube</h3>
          <p>Pre-roll, creator integrations, and product features that turn viewers into buyers.</p>
        </div>
        <div class="channel-card">
          <div class="channel-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="2"/><path d="M4.9 19.1a10 10 0 0 1 0-14.2"/><path d="M19.1 4.9a10 10 0 0 1 0 14.2"/><path d="M7.8 16.2a6 6 0 0 1 0-8.4"/><path d="M16.2 7.8a6 6 0 0 1 0 8.4"/></svg>
          </div>
          <h3>Live Streaming</h3>
          <p>Twitch, Kick, and TikTok Live activations that drive real-time engagement and sales.</p>
        </div>
        <div class="channel-card">
          <div class="channel-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          </div>
          <h3>Whatnot</h3>
          <p>Live shopping events and giveaway drops that convert viewers into repeat buyers.</p>
        </div>
        <div class="channel-card">
          <div class="channel-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg>
          </div>
          <h3>Amazon</h3>
          <p>Sponsored Products, storefronts, and listing optimization that win the buy box.</p>
        </div>
        <div class="channel-card">
          <div class="channel-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41 13.42 20.6a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82Z"/><circle cx="7" cy="7" r="1.5"/></svg>
          </div>
          <h3>eBay</h3>
          <p>Marketplace presence and promoted listings that extend your reach beyond your own site.</p>
        </div>
      </div>
    </section>

    <section class="packages-section">
      <div class="section-intro">
        <span class="section-eyebrow">ADVERTISING PACKAGES</span>
        <h2>Pick a package. We handle the rest.</h2>
        <p>Clear scope, transparent ad spend, and a dashboard that shows exactly where your money goes.</p>
      </div>
      <div class="packages-grid">
        <div class="package-card">
          <h3>Launch</h3>
          <p class="package-for">For up-and-coming brands getting their first real reach.</p>
          <ul>
            <li>2 channels of your choice</li>
            <li>Monthly content calendar</li>
            <li>Campaign setup &amp; management</li>
            <li>Access to the analytics dashboard</li>
          </ul>
          <a href="/services" class="package-cta">Start with Launch</a>
        </div>
        <div class="package-card package-card--featured">
          <span class="package-badge">Most Popular</span>
          <h3>Scale</h3>
          <p class="package-for">For growing brands ready to own their niche across channels.</p>
          <ul>
            <li>4 channels of your choice</li>
            <li>Creator &amp; sponsorship outreach</li>
            <li>Weekly optimization &amp; reporting</li>
            <li>Full dashboard + ad spend tracking</li>
          </ul>
          <a href="/services" class="package-cta">Scale Your Reach</a>
        </div>
        <div class="package-card">
          <h3>Dominate</h3>
          <p class="package-for">For brick-and-mortar retailers building a full online presence.</p>
          <ul>
            <li>All channels, fully managed</li>
            <li>Dedicated account manager</li>
            <li>Custom dashboards &amp; budgets</li>
            <li>Marketplace + live shopping builds</li>
          </ul>
          <a href="/services" class="package-cta">Build Your Presence</a>
        </div>
      </div>
    </section>

    <section class="dashboard-preview-section">
      <div class="dashboard-preview-content">
        <span class="section-eyebrow">YOUR NUMBERS, LIVE</span>
        <h2>A dashboard that makes ad spend make sense.</h2>
        <p>Every campaign, channel, and dollar in one place — impressions, clicks, conversions, ROAS, and spend, updated as it happens.</p>
        <a href="/contact" class="cta-primary">Book a Free Strategy Call</a>
      </div>
      <div class="dashboard-mock">
        <div class="mock-header">
          <span class="mock-dot mock-dot--red"></span>
          <span class="mock-dot mock-dot--amber"></span>
          <span class="mock-dot mock-dot--green"></span>
          <span class="mock-title">Campaign Overview</span>
        </div>
        <div class="mock-stats">
          <div class="mock-stat">
            <span class="mock-label">Ad Spend</span>
            <span class="mock-value">$24,180</span>
            <span class="mock-change mock-change--up">+12.4%</span>
          </div>
          <div class="mock-stat">
            <span class="mock-label">ROAS</span>
            <span class="mock-value">4.2x</span>
            <span class="mock-change mock-change--up">+0.6x</span>
          </div>
          <div class="mock-stat">
            <span class="mock-label">Conversions</span>
            <span class="mock-value">1,842</span>
            <span class="mock-change mock-change--up">+18.2%</span>
          </div>
        </div>
        <div class="mock-chart">
          <div class="mock-bar" style="height: 40%"></div>
          <div class="mock-bar" style="height: 55%"></div>
          <div class="mock-bar" style="height: 35%"></div>
          <div class="mock-bar" style="height: 70%"></div>
          <div class="mock-bar" style="height: 60%"></div>
          <div class="mock-bar" style="height: 85%"></div>
          <div class="mock-bar" style="height: 75%"></div>
          <div class="mock-bar" style="height: 95%"></div>
        </div>
      </div>
    </section>

    <section class="cta-band">
      <h2>Ready to turn attention into revenue?</h2>
      <p>Tell us about your brand — online, in-store, or both — and we'll map out the fastest path to reach.</p>
      <div class="cta-band-actions">
        <a href="/contact" class="cta-primary">Book a Free Strategy Call</a>
        <a href="/services" class="cta-secondary">Compare Packages</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Hero Section */
  .hero {
    position: relative;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding: 5rem 0 4rem;
    align-items: center;
    overflow: hidden;
  }

  .hero-inner {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  .hero-bg-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: url("/assets/hero-bg.png") center / cover no-repeat;
    z-index: -2;
    pointer-events: none;
    filter: blur(32px);
    transform: scale(1.18);
  }

  .hero-bg-wash {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(to bottom,
        rgba(247, 245, 240, 0.96) 0%,
        rgba(247, 245, 240, 0.78) 32%,
        rgba(247, 245, 240, 0.66) 62%,
        rgba(247, 245, 240, 0.92) 100%),
      linear-gradient(135deg, rgba(143, 174, 143, 0.22), rgba(143, 174, 143, 0.08));
  }

  .hero-bg-glow {
    display: none;
  }

  .hero-content,
  .hero-auth,
  .hero-visual {
    position: relative;
    z-index: 1;
  }

  @media (min-width: 768px) {
    .hero-inner {
      grid-template-columns: 1.5fr 1fr;
    }
    .hero {
      padding: 6rem 0;
    }
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }

  .hero h1 {
    font-size: 2.75rem;
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 1.25rem;
  }

  @media (min-width: 768px) {
    .hero h1 {
      font-size: 3.75rem;
    }
  }

  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin-bottom: 2.25rem;
    line-height: 1.65;
    max-width: 32rem;
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cta-primary {
    display: inline-block;
    background: var(--accent);
    color: var(--primary);
    padding: 0.9rem 1.75rem;
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 700;
    transition: all 0.2s;
    box-shadow: 0 4px 20px rgba(143, 174, 143, 0.25);
  }

  .cta-primary:hover {
    transform: translateY(-2px);
    background: var(--accent-hover);
    box-shadow: 0 6px 26px rgba(143, 174, 143, 0.35);
  }

  .cta-secondary {
    display: inline-block;
    color: var(--text);
    padding: 0.9rem 1.75rem;
    border: 2px solid var(--border-hover);
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s;
  }

  .cta-secondary:hover {
    background: var(--surface-elev);
    border-color: var(--text-secondary);
    color: var(--text);
  }

  .hero-visual {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .visual-card {
    background: linear-gradient(160deg, var(--surface-elev) 0%, var(--surface) 100%);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 1.5rem 1rem;
    border-radius: var(--radius);
    text-align: center;
    transition: all 0.25s;
  }

  .visual-card:hover {
    border-color: rgba(143, 174, 143, 0.55);
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .visual-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    margin: 0 auto 1rem;
    border-radius: 50%;
    background: rgba(143, 174, 143, 0.12);
    color: var(--accent);
  }

  .visual-card h3 {
    font-size: 0.9375rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
    color: var(--text);
  }

  .visual-card p {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  /* Section shared styles */
  .channels-section,
  .packages-section,
  .dashboard-preview-section {
    padding: 4rem 0;
  }

  .section-intro {
    max-width: 44rem;
    margin-bottom: 2.5rem;
  }

  .section-eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .section-intro h2,
  .dashboard-preview-content h2,
  .cta-band h2 {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 0.75rem;
    line-height: 1.15;
  }

  .section-intro p,
  .dashboard-preview-content p {
    color: var(--text-secondary);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  /* Channels */
  .channels-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .channels-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .channels-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .channel-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    transition: all 0.25s;
  }

  .channel-card:hover {
    border-color: rgba(143, 174, 143, 0.55);
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }

  .channel-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.625rem;
    background: rgba(143, 174, 143, 0.12);
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .channel-card h3 {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.4rem;
  }

  .channel-card p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* Packages */
  .packages-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }

  @media (min-width: 768px) {
    .packages-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .package-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem;
    transition: all 0.25s;
  }

  .package-card:hover {
    border-color: rgba(143, 174, 143, 0.4);
    transform: translateY(-3px);
  }

  .package-card--featured {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent), 0 18px 40px rgba(143, 174, 143, 0.15);
  }

  .package-badge {
    position: absolute;
    top: -0.75rem;
    left: 2rem;
    background: var(--accent);
    color: var(--primary);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.6rem;
    border-radius: 0.375rem;
  }

  .package-card h3 {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .package-for {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  .package-card ul {
    list-style: none;
    padding: 0;
    margin: 0 0 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    flex: 1;
  }

  .package-card li {
    position: relative;
    padding-left: 1.5rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .package-card li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }

  .package-cta {
    display: block;
    text-align: center;
    padding: 0.75rem 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--border-hover);
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9375rem;
    transition: all 0.2s;
  }

  .package-cta:hover {
    background: var(--surface-elev);
    border-color: var(--accent);
  }

  .package-card--featured .package-cta {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--primary);
  }

  .package-card--featured .package-cta:hover {
    background: var(--accent-hover);
  }

  /* Dashboard preview */
  .dashboard-preview-section {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .dashboard-preview-section {
      grid-template-columns: 1fr 1fr;
    }
  }

  .dashboard-preview-content p {
    margin-bottom: 1.75rem;
  }

  .dashboard-mock {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .mock-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface-elev);
  }

  .mock-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
  }

  .mock-dot--red { background: #ef4444; }
  .mock-dot--amber { background: #f59e0b; }
  .mock-dot--green { background: #10b981; }

  .mock-title {
    margin-left: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
