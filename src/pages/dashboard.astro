---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Dashboard — Partner Revenue Labs";
const description = "Preview the Partner Revenue Labs client dashboard: track ad spend, ROAS, impressions, and conversions across every channel in one place.";
const canonical = "https://yourdomain.com/dashboard";

const stats = [
  { label: "Ad Spend", value: "$24,180", change: "+12.4%", up: true },
  { label: "ROAS", value: "4.2x", change: "+0.6x", up: true },
  { label: "Impressions", value: "1.9M", change: "+8.1%", up: true },
  { label: "Conversions", value: "1,842", change: "+18.2%", up: true },
];

const channels = [
  { name: "Instagram / Facebook", spend: 6200, revenue: 26800, roas: 4.3, share: 82 },
  { name: "TikTok", spend: 4800, revenue: 17500, roas: 3.6, share: 68 },
  { name: "YouTube", spend: 5400, revenue: 22600, roas: 4.2, share: 75 },
  { name: "Twitch / Live", spend: 2600, revenue: 9800, roas: 3.8, share: 62 },
  { name: "Whatnot", spend: 1800, revenue: 8400, roas: 4.7, share: 88 },
  { name: "Amazon", spend: 2400, revenue: 11300, roas: 4.7, share: 90 },
  { name: "eBay", spend: 980, revenue: 3700, roas: 3.8, share: 65 },
];
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="container">
    <section class="dash-header">
      <div>
        <span class="hero-eyebrow">CLIENT DASHBOARD</span>
        <h1>Your ad spend, finally transparent.</h1>
        <p class="page-subtitle">Every channel, campaign, and dollar in one live view. This is a live preview of the dashboard included in every Partner Revenue Labs package.</p>
      </div>
      <div class="dash-live">
        <span class="live-dot"></span>
        <span>Live preview</span>
      </div>
    </section>

    <section class="stats-grid">
      {stats.map((s) => (
        <div class="stat-card">
          <span class="stat-label">{s.label}</span>
          <span class="stat-value">{s.value}</span>
          <span class="stat-change">▲ {s.change} vs last month</span>
        </div>
      ))}
    </section>

    <section class="dash-grid">
      <div class="panel">
        <h2>Spend by channel</h2>
        <p class="panel-sub">Last 30 days · USD</p>
        <div class="bars">
          {channels.map((c) => (
            <div class="bar-row">
              <span class="bar-name">{c.name}</span>
              <div class="bar-track">
                <div class="bar-fill" style={`width: ${(c.spend / 6200) * 100}%`}></div>
              </div>
              <span class="bar-value">${c.spend.toLocaleString()}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="panel">
        <h2>Budget pacing</h2>
        <p class="panel-sub">How much of each monthly budget is spent</p>
        <div class="pace-list">
          {channels.map((c) => (
            <div class="pace-row">
              <div class="pace-head">
                <span>{c.name}</span>
                <span class="pace-pct">{c.share}%</span>
              </div>
              <div class="pace-track">
                <div class="pace-fill" style={`width: ${c.share}%`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="panel table-panel">
      <h2>Channel performance</h2>
      <p class="panel-sub">Spend, revenue, and return on ad spend by channel</p>
      <div class="table-wrap">
        <table class="dash-table">
          <thead>
            <tr>
              <th>Channel</th>
              <th>Spend</th>
              <th>Revenue</th>
              <th>ROAS</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {channels.map((c) => (
              <tr>
                <td>{c.name}</td>
                <td>${c.spend.toLocaleString()}</td>
                <td>${c.revenue.toLocaleString()}</td>
                <td class="roas">{c.roas}x</td>
                <td><span class={c.roas >= 4 ? "status status--good" : "status status--ok"}>{c.roas >= 4 ? "Scaling" : "Optimizing"}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="cta-band">
      <h2>Want this for your brand?</h2>
      <p>Every package ships with dashboard access. Book a call and we'll show you how it maps to your channels and budget.</p>
      <div class="cta-band-actions">
        <a href="/contact" class="cta-primary">Book a Free Strategy Call</a>
        <a href="/services" class="cta-secondary">See Packages</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .dash-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    padding: 4rem 0 2rem;
    flex-wrap: wrap;
  }

  .dash-header h1 {
    font-size: 2.5rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 0.75rem;
    line-height: 1.1;
  }

  .page-subtitle {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 34rem;
  }

  .dash-live {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .live-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.5);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.5); }
    70% { box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
    100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 640px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .stats-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
  }

  .stat-label {
    display: block;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .stat-value {
    display: block;
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--text);
    margin-bottom: 0.25rem;
  }

  .stat-change {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
  }

  .dash-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 900px) {
    .dash-grid {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .panel h2 {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.25rem;
  }

  .panel-sub {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
  }

  .bars {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .bar-row {
    display: grid;
    grid-template-columns: 9rem 1fr 4.5rem;
    gap: 0.75rem;
    align-items: center;
  }

  .bar-name {
    font-size: 0.75rem;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bar-track {
    height: 0.5rem;
    background: var(--surface-elev);
    border-radius: 999px;
    overflow: hidden;
  }

  .bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent-hover), var(--accent));
    border-radius: 999px;
  }

  .bar-value {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text);
    text-align: right;
  }

  .pace-list {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .pace-head {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin-bottom: 0.35rem;
  }

  .pace-pct {
    font-weight: 700;
    color: var(--text);
  }

  .pace-track {
    height: 0.4rem;
    background: var(--surface-elev);
    border-radius: 999px;
    overflow: hidden;
  }

  .pace-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 999px;
  }

  .table-panel {
    margin-bottom: 2rem;
  }

  .table-wrap {
    overflow-x: auto;
  }

  .dash-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .dash-table th {
    text-align: left;
    padding: 0.6rem 0.75rem;
    background: var(--surface-elev);
    color: var(--text);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .dash-table td {
    padding: 0.7rem 0.75rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .dash-table td.roas {
    font-weight: 700;
    color: var(--accent);
  }

  .status {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .status--good {
    background: rgba(16, 185, 129, 0.14);
    color: #34d399;
  }

  .status--ok {
    background: rgba(245, 158, 11, 0.14);
    color: #fbbf24;
  }

  .cta-band {
    margin: 1rem 0 3rem;
    padding: 3rem 2rem;
    border-radius: var(--radius);
    background:
      radial-gradient(circle at 20% 20%, rgba(16, 185, 129, 0.16), transparent 55%),
      radial-gradient(circle at 85% 80%, rgba(212, 43, 43, 0.14), transparent 55%),
      var(--surface);
    border: 1px solid var(--border);
    text-align: center;
  }

  .cta-band h2 {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--text);
    margin-bottom: 0.75rem;
  }

  .cta-band p {
    color: var(--text-secondary);
    max-width: 36rem;
    margin: 0 auto 1.75rem;
    line-height: 1.6;
  }

  .cta-band-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-primary {
    display: inline-block;
    background: var(--accent);
    color: var(--primary);
    padding: 0.9rem 1.75rem;
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 700;
    transition: all 0.2s;
    box-shadow: 0 4px 20px rgba(16, 185, 129, 0.25);
  }

  .cta-primary:hover {
    transform: translateY(-2px);
    background: var(--accent-hover);
  }

  .cta-secondary {
    display: inline-block;
    color: var(--text);
    padding: 0.9rem 1.75rem;
    border: 2px solid var(--border-hover);
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s;
  }

  .cta-secondary:hover {
    background: var(--surface-elev);
    border-color: var(--text-secondary);
  }

  @media (max-width: 640px) {
    .dash-header h1 { font-size: 1.9rem; }
    .bar-row { grid-template-columns: 7rem 1fr 4rem; }
  }
</style>
