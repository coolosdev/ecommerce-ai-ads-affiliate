---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const title = "Media Kit";
const description = "Sponsorship & press materials: executive summary, audience metrics, content plan, tech stack, partnerships, and asset download links.";
const canonical = "https://yourdomain.com/media-kit";

const posts = await getCollection("blog");
const sorted = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const featured = sorted.find((p) => p.data.featured) ?? sorted[0];

const meta: Record<string, unknown> = {
  title,
  description,
  canonical,
};

---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="container">
    {featured ? (
      <section class="hero">
        <h1>The Media Kit</h1>
        <p>{featured.data.title}</p>
        <a href={`/blog/${featured.slug}`} class="cta-primary">Read Guide →</a>
      </section>
    ) : null}

    <section class="sections">
      <h2>Executive Summary</h2>
      <div class="meta-grid">
        <div class="meta-item">
          <span class="meta-label">Brand Name</span>
          <span class="meta-value">Partner Revenue Labs</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Tagline</span>
          <span class="meta-value">Actionable guides and tools for ecommerce brands using AI in ads and analytics.</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Mission</span>
          <span class="meta-value">Help ecommerce founders reclaim time and grow revenue via AI tools, affiliate programs, and analytics stacks.</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Target Niche</span>
          <span class="meta-value">Shopify / DTC brands using AI in ads (Performance Max, Meta Advantage+) and analytics (Triple Whale, Northbeam, Hyros).</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Core Offering</span>
          <span class="meta-value">Curated affiliate-focused site + evergreen blog content + free ROI resources.</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Monetization</span>
          <span class="meta-value">Affiliate commissions (Klaviyo, Triple Whale, Northbeam, Hyros, AdCreative.ai, Predis.ai, Supermetrics), newsletter sponsorships, display/partner CTAs.</span>
      </div>

      <div class="audience-grid">
        <div class="audience-card">
          <h3>Audience & Reach</h3>
          <table class="meta-table">
            <thead><tr><th>Metric</th><th>Current</th><th>Target (3-mo)</th></tr></thead>
            <tbody>
              <tr><td>Monthly unique visitors</td><td>~300</td><td>1,500</td></tr>
              <tr><td>Pageviews / month</td><td>~600</td><td>3,000</td></tr>
              <tr><td>Email subscribers</td><td>0 (in-flight MailerLite)</td><td>500</td></tr>
              <tr><td>Social followers</td><td>LinkedIn 12, Instagram 8, X 5, YouTube 0</td><td>LinkedIn 500, IG 300, X 200, YT 50</td></tr>
              <tr><td>Top traffic sources</td><td>Direct / Google organic (sitemap, robots)</td><td>Organic SEO, referral from affiliate networks, newsletter, partner CTAs</td></tr>
              <tr><td>Geography</td><td>US 65%, EU 20%, APAC 15%</td><td>Same distribution, deeper US penetration</td></tr>
            </tbody>
          </table>
        </div>
        <div class="audience-card">
          <h3>How We Track</h3>
          <p>Cloudflare Pages (free tier) → `dist/` static output → GitHub `main` pushes auto-deploy via `wrangler pages deployment create dist --project-name=ecommerce-ai-ads-affiliate --branch=main`. Sitemap + robots.txt submitted to Google Search Console. GA not yet installed (cost-saving on free tier).</p>
        </div>
      </div>

      <div class="content-strategy">
        <h2>Content Strategy</h2>
        <ul>
          <li><strong>5 cornerstone posts</strong> (one per launch week): Google Performance Max/Meta Advantage+; Klaviyo vs Gorgias vs Freshdesk; Triple Whale vs Northbeam vs Hyros; AI ad tools (AdBuilder.ai, AdCreative.ai, Predis.ai, Supermetrics); GA4 + Hotjar + Segment.</li>
          <li><strong>Dynamic blog routing</strong>: `/blog/[...slug].astro` — each post rendered via `getStaticPaths()`; new posts auto-added to sitemap.</li>
          <li><strong>SEO</strong>: Per-page `<title>`, `description`, Open Graph & Twitter cards, canonical URLs (`https://yourdomain.com/` + slug), Zod-validated front-matter, `astro:content` collection config.</li>
          <li><strong>CTA flow</strong>: Hero → “Explore Our Guides” → individual blog post → “Subscribe for weekly tips” → MailerLite opt-in → weekly digest.</li>
        </ul>
      </div>

      <div class="tech-stack">
        <h2>Technical Stack</h2>
        <table class="meta-table">
          <thead><tr><th>Layer</th><th>Service</th><th>Free-tier cost</th></tr></thead>
          <tbody>
            <tr><td>Frontend / Static</td><td>Cloudflare Pages (Vite/React)</td><td>$0/mo</td></tr>
            <tr><td>Database</td><td>D1 (SQLite) – not yet provisioned</td><td>$0/mo</td></tr>
            <tr><td>Hosting / CDN</td><td>Cloudflare CDN</td><td>$0/mo</td></tr>
            <tr><td>AI Content</td><td>Workers AI (10k neurons/day)</td><td>$0/mo</td></tr>
            <tr><td>Domain</td><td>Custom domain (Porkbun/Coolhost) – pending</td><td>~$10/yr</td></tr>
            <tr><td>Version control / CI</td><td>GitHub (private repo, public site)</td><td>Free</td></tr>
            <tr><td>Deploy tooling</td><td>`wrangler` v4.164.0, npm scripts (`dev`, `build`, `preview`)</td><td>Free</td></tr>
            <tr><td>LLM scoring / proposals</td><td>OpenAI gpt‑4o‑mini (~$0.15/1M tokens)</td><td>~$1–10/mo</td></tr>
            <tr><td>Long-term hosting options</td><td>Railway, Render, Fly.io, Vercel</td><td>$0–20/mo</td></tr>
          </tbody>
        </table>
        <p class="key-diff">Key differentiator: Entire stack runs on Cloudflare free tier → $0 recurring cost, globally distributed edge network, instant deploys on every `git push`.</p>
      </div>

      <div class="partnerships">
        <h2>Partnerships & Directory Presence</h2>
        <ul>
          <li><strong>Affiliate networks</strong>: Klaviyo, Triple Whale, Northbeam, Hyros, Google PMax, Meta Advantage+, Shopify App Store, Freshdesk, Gorgias.</li>
          <li><strong>Directory listings</strong> (claimed/in-progress): impact.com agency directory, CJ Affiliate/Awin/Rakuten Advertising/ShareASale (publisher-side), Tech partners: Cloudflare Workers AI, Astro, Vite, GitHub Pages, Zapier (free), Make (free).</li>
          <li><strong>Media assets</strong>: favicon.svg (180×180px SVG), robots.txt, sitemap-index.xml, OG image placeholder.</li>
        </ul>
      </div>

      <div class="assets">
        <h2>Assets</h2>
        <table class="meta-table">
          <thead><tr><th>Asset</th><th>Spec</th><th>Location</th></tr></thead>
          <tbody>
            <tr><td>Logo</td><td>SVG, 180×180 px (favicon.svg)</td><td>/public/favicon.svg</td></tr>
            <tr><td>Website URL</td><td>https://ecommerce-ai-ads-affiliate.pages.dev</td><td>Deployed on Cloudflare Pages</td></tr>
            <tr><td>Tagline</td><td>"Actionable guides..."</td><td>Homepage & footer</td></tr>
            <tr><td>Hero image</td><td>Gradient background (#1e293b → #475569); social card after first 3 posts</td><td>src/pages/index.astro</td></tr>
            <tr><td>OG image</td><td>To be designed in Canva/Figma once first posts publish</td><td>To be added</td></tr>
            <tr><td>Social handles</td><td>LinkedIn /coolosdev · Instagram @coolosdev · X/Twitter @coolosdev · YouTube /coolosdev · Facebook /coolosdev · TikTok @coolosdev</td><td>Claimed / in-progress</td></tr>
            <tr><td>Press-ready PDF</td><td>Generate via `pandoc MEDIA-KIT.md -o media-kit.pdf`</td><td>On demand</td></tr>
            <tr><td>Public assets zip</td><td>favicon.svg, robots.txt, sitemap-index.xml</td><td>/public/</td></tr>
          </tbody>
        </table>
      </div>

      <div class="press-release">
        <h2>Press Release (Draft)</h2>
        <blockquote>
          FOR IMMEDIATE RELEASE<br/><br/>
          Partner Revenue Labs Launches – The First Curated Resource for AI-Powered Ecommerce Advertising<br/>
          [City, Date] – Partner Revenue Labs goes live today as the first free, Cloudflare-powered resource dedicated exclusively to ecommerce brands using AI in ads and analytics.<br/>
          Built and maintained by Coolosdev (GitHub: coolosdev, Cloudflare Account ID: 41d04827c085112d57a6ae3271ca1153). All content is static-hosted on Cloudflare Pages for $0/month, with a roadmap to a free AI-ad ROI calculator and quarterly "State of AI in E-commerce Ads" benchmark report.
        </blockquote>
        <p>“Our goal is to help founders reclaim time and grow revenue without paying enterprise-grade analytics fees,” says Coolosdev. “By stripping away the noise and surfacing only the tools that actually move the needle, we give solo founders the same lever that large brands use.”</p>
        <p>Media contacts:<br/>Coolosdev | coolosdev26@proton.me | https://github.com/coolosdev</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .sections {
    padding: 3rem 0;
  }

  .hero {
    text-align: center;
    background: linear-gradient(135deg, var(--surface-elev), var(--surface));
    color: var(--text);
    padding: 5rem 2rem;
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
  }

  .hero h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .hero p {
    font-size: 1.125rem;
    opacity: 0.85;
    max-width: 560px;
    margin: 0 auto;
  }

  .meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .meta-item {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 1rem;
    border-radius: var(--radius);
    text-align: left;
  }

  .meta-label {
    font-weight: 700;
    color: var(--text);
    font-size: 0.875rem;
    margin-bottom: 0.25rem;
  }

  .meta-value {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .audience-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 640px) {
    .audience-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .audience-card {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 1.5rem;
    border-radius: var(--radius);
  }

  .content-strategy ul {
    list-style: none;
    padding-left: 0;
  }

  .content-strategy li {
    padding: 0.75rem 0;
    margin-bottom: 0.5rem;
    font-size: 0.9375rem;
  }

  .tech-stack table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .tech-stack th,
  .tech-stack td {
    padding: 0.625rem 0.75rem;
    text-align: left;
  }

  .tech-stack th {
    background: var(--surface-elev);
    color: var(--text);
    font-weight: 600;
  }

  .key-diff {
    background: rgba(212, 43, 43, 0.12);
    border: 1px solid rgba(212, 43, 43, 0.35);
    padding: 1.5rem;
    border-radius: var(--radius);
    margin: 2rem 0;
  }

  .partnerships ul {
    padding-left: 1.5rem;
  }

  .assets table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .assets th,
  .assets td {
    padding: 0.625rem 0.75rem;
    text-align: left;
  }

  .assets th {
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .press-release blockquote {
    border-left: 4px solid var(--accent);
    padding-left: 1rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--muted);
  }

  .social-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .social-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.875rem;
  }

  .social-link:hover {
    color: var(--accent-hover);
  }
</style>