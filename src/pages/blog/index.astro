---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const title = "Blog";
const description = "Actionable guides for ecommerce brands using AI in ads and analytics.";
const canonical = "https://yourdomain.com/blog";

const posts = await getCollection("blog");
const sorted = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const featured = sorted.find((p) => p.data.featured) ?? sorted[0];
const rest = sorted.filter((p) => p.slug !== featured?.slug);
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="container">
    <section class="page-hero">
      <h1>The Blog</h1>
      <p>Actionable guides on AI ads, analytics, attribution, and the tools that move ecommerce forward.</p>
    </section>

    {featured ? (
      <section class="featured-banner">
        <a href={`/blog/${featured.slug}`} class="featured-link">
          <div class="featured-badge">Featured</div>
          <h2>{featured.data.title}</h2>
          <p>{featured.data.description}</p>
          <div class="featured-meta">
            <time>{featured.data.pubDate.toDateString()}</time>
            <span class="read-more">Read guide →</span>
          </div>
        </a>
      </section>
    ) : null}

    <section class="posts-section">
      <h2>All Guides</h2>
      <div class="posts-grid">
        {rest.map((post) => (
          <article class="post-card" key={post.slug}>
            <div class="post-card-accent"></div>
            <div class="post-card-body">
              <div class="post-card-top">
                <time>{post.data.pubDate.toDateString()}</time>
                {post.data.tags && post.data.tags.length > 0 && (
                  <span class="post-category">{post.data.tags[0]}</span>
                )}
              </div>
              <h3><a href={`/blog/${post.slug}`}>{post.data.title}</a></h3>
              <p>{post.data.description?.slice(0, 120)}...</p>
              <a href={`/blog/${post.slug}`} class="read-link">Read guide →</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .page-hero {
    background: var(--primary);
    color: var(--foreground);
    padding: 4rem 2rem;
    text-align: center;
  }

  .page-hero h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
  }

  .page-hero p {
    font-size: 1.125rem;
    opacity: 0.8;
    max-width: 560px;
    margin: 0 auto;
  }

  .featured-banner {
    margin: -2rem auto 0;
    max-width: 900px;
    position: relative;
    z-index: 2;
  }

  .featured-link {
    display: block;
    background: linear-gradient(135deg, var(--accent), #059669);
    color: #ffffff;
    text-decoration: none;
    padding: 2rem;
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .featured-link:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.15);
  }

  .featured-badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(4px);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .featured-link h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }

  .featured-link p {
    opacity: 0.9;
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .featured-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.875rem;
  }

  .read-more {
    font-weight: 700;
  }

  .posts-section {
    padding: 3rem 0;
  }

  .posts-section h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 1.5rem;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .post-card {
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    transition: all 0.2s;
  }

  .post-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .post-card-accent {
    width: 4px;
    background: linear-gradient(180deg, var(--accent), #3b82f6);
    flex-shrink: 0;
  }

  .post-card-body {
    padding: 1.5rem;
    flex: 1;
  }

  .post-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .post-category {
    background: #f1f5f9;
    color: var(--primary);
    padding: 0.125rem 0.5rem;
    border-radius: 0.25rem;
    font-weight: 600;
  }

  .post-card-body h3 {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .post-card-body h3 a {
    color: inherit;
    text-decoration: none;
  }

  .post-card-body h3 a:hover {
    color: var(--accent);
  }

  .post-card-body p {
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }

  .read-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.875rem;
    transition: color 0.2s;
  }

  .read-link:hover {
    color: var(--accent-hover);
  }
</style>