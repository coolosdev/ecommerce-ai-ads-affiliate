---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "About Us";
const description = "Learn about Partner Revenue Labs - our mission and approach to helping ecommerce brands leverage AI.";
const canonical = "https://yourdomain.com/about";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="container">
    <section class="about-section">
      <h1>About Us</h1>
      <p class="intro">We help ecommerce brands make smarter decisions with AI-powered advertising and analytics.</p>

      <div class="mission-card">
        <h2>Our Mission</h2>
        <p>We believe that every ecommerce brand deserves access to world-class AI insights and strategies. Whether you're running paid ads, optimizing your analytics stack, or scaling your experimentation program, we're here to provide actionable, data-driven guidance.</p>
      </div>

      <div class="values-grid">
        <div class="value-card">
          <div class="value-icon">🎯</div>
          <h3>Data-Driven</h3>
          <p>We base every recommendation on real data and proven experiments.</p>
        </div>
        <div class="value-card">
          <div class="value-icon">⚡</div>
          <h3>Actionable</h3>
          <p>Every guide includes clear next steps and implementation tactics.</p>
        </div>
        <div class="value-card">
          <div class="value-icon">🤝</div>
          <h3>Partners</h3>
          <p>We collaborate with leading AI tools and platforms to bring you expert insights.</p>
        </div>
      </div>

      <div class="contact-cta">
        <h2>Ready to learn more?</h2>
        <p>Get in touch with us about partnerships, media inquiries, or speaking opportunities.</p>
        <a href="/contact" class="cta-primary">Contact Us</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .about-section {
    padding: 4rem 0;
  }

  .about-section h1 {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .intro {
    font-size: 1.25rem;
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .mission-card {
    background: var(--surface-elev);
    border: 1px solid var(--border);
    padding: 2rem;
    border-radius: var(--radius);
    margin-bottom: 2rem;
  }

  .mission-card h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.75rem;
  }

  .mission-card p {
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .values-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 768px) {
    .values-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .value-card {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 1.5rem;
    border-radius: var(--radius);
    text-align: center;
    transition: all 0.2s;
  }

  .value-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .value-icon {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .value-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .value-card p {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .contact-cta {
    background: var(--surface-elev);
    color: var(--text);
    padding: 2rem;
    border-radius: var(--radius);
    text-align: center;
  }

  .contact-cta h2 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .contact-cta p {
    opacity: 0.9;
    margin-bottom: 1.25rem;
  }
</style>