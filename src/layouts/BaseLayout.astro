---
import SEO from "../components/SEO.astro";

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  schema?: Record<string, unknown>;
}

const {
  title = "Partner Revenue Labs",
  description = "Revenue-focused guides and tools for ecommerce brands using AI in ads and analytics.",
  canonical = "https://yourdomain.com/",
  ogImage,
  schema,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f7f5f0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <SEO title={title} description={description} canonical={canonical} ogImage={ogImage} schema={schema} />
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="logo">
          <span class="logo-badge">PRL</span>
          <div class="logo-text">
            <div class="logo-line">PARTNER REVENUE</div>
            <div class="logo-sub">LABS</div>
          </div>
        </a>
        <nav class="nav">
          <a href="/services">Services</a>
          <a href="/#tech">Technology <span class="nav-badge">New</span></a>
          <a href="/#case-studies">Case Studies</a>
          <a href="/#calculator">ROI Model</a>
          <a href="/about">About</a>
        </nav>
      </div>
      <div class="header-actions">
        <a href="/contact" class="client-portal-link">Client Portal</a>
        <a href="/#audit" class="header-cta">
          <span>Request Growth Audit</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <p>&copy; {new Date().getFullYear()} Partner Revenue Labs. All rights reserved.</p>
        <div class="footer-links">
          <a href="/services">Services</a>
          <a href="/blog">Insights</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
          <a href="/media-kit">Media Kit</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  :root {
    --background: #f4f3ee;
    --surface: #ffffff;
    --surface-elev: #faf9f5;
    --border: #e8e6df;
    --border-hover: #d6d3c9;
    --text: #121316;
    --text-secondary: #5f6368;
    --muted: #8a8f98;
    --primary: #121316;
    --secondary: #faf9f5;
    --accent: #8ca388;
    --accent-hover: #6e876a;
    --brand-red: #d92d20;
    --radius: 1.25rem;
    --shadow-sm: 0 1px 3px 0 rgba(18, 19, 22, 0.06);
    --shadow-md: 0 8px 24px -8px rgba(18, 19, 22, 0.12);
    --shadow-lg: 0 20px 45px -12px rgba(18, 19, 22, 0.10);
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: "Archivo", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.6;
    color: var(--text);
    background: var(--background);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .site-header {
    position: sticky;
    top: 0.75rem;
    z-index: 50;
    margin: 0.75rem auto 0;
    max-width: 1100px;
    background: rgba(255, 255, 255, 0.82);
    border: 1px solid var(--border);
    border-radius: 999px;
    backdrop-filter: blur(12px);
    box-shadow: var(--shadow-md);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-right: 0.75rem;
  }

  .header-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0.6rem 0.6rem 0.6rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-shrink: 0;
  }

  .client-portal-link {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s;
    white-space: nowrap;
  }

  .client-portal-link:hover {
    color: var(--text);
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: #ffffff;
    background: var(--accent);
    text-decoration: none;
    padding: 0.55rem 1.05rem;
    border-radius: 999px;
    transition: background 0.2s, box-shadow 0.2s, transform 0.2s;
    box-shadow: 0 2px 8px rgba(140, 163, 136, 0.35);
    white-space: nowrap;
  }

  .header-cta:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
  }

  .header-cta svg {
    flex-shrink: 0;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    transition: opacity 0.2s;
    flex-shrink: 0;
  }

  .logo:hover {
    opacity: 0.85;
  }

  .logo-badge {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    background: var(--brand-red);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    flex-shrink: 0;
    box-shadow: 0 2px 6px rgba(217, 45, 32, 0.3);
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .logo-line {
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    color: var(--text);
    white-space: nowrap;
  }

  .logo-sub {
    font-weight: 600;
    font-size: 0.55rem;
    letter-spacing: 0.35em;
    color: var(--accent);
    margin-top: 0.15rem;
    text-align: center;
    margin-left: 0.3em;
  }

  @media (max-width: 640px) {
    .logo-line {
      font-size: 0.85rem;
    }
    .logo-sub {
      font-size: 0.45rem;
    }
    .logo-badge {
      width: 1.6rem;
      height: 1.6rem;
      font-size: 0.6rem;
    }
  }

  .nav {
    display: flex;
    gap: 0.35rem;
    margin-left: 1.5rem;
    padding: 0.25rem;
    background: var(--surface-elev);
    border-radius: 999px;
    box-shadow: var(--shadow-sm);
    flex-shrink: 0;
  }

  .nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 1.05rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--text-secondary);
    background: transparent;
    transition: color 0.2s, background 0.2s, box-shadow 0.2s;
    white-space: nowrap;
  }

  .nav-badge {
    background: var(--accent);
    color: var(--primary);
    font-size: 0.6rem;
    font-weight: 700;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    letter-spacing: 0.04em;
  }

  @media (max-width: 560px) {
    .nav {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding: 0.2rem;
    }
    .nav::-webkit-scrollbar { display: none; }
    .nav a {
      padding: 0.42rem 0.7rem;
      font-size: 0.7rem;
    }
    .header-inner {
      gap: 0.75rem;
      padding: 0.5rem 0.5rem 0.5rem 0.8rem;
    }
    .logo {
      flex-shrink: 0;
    }
    .logo-badge {
      width: 1.6rem;
      height: 1.6rem;
    }
    .client-portal-link {
      display: none;
    }
    .header-cta {
      font-size: 0.68rem;
      padding: 0.45rem 0.75rem;
      gap: 0.3rem;
    }
    .header-cta span {
      display: none;
    }
  }

  .nav a:hover {
    color: var(--primary);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .nav a.active {
    color: var(--primary);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  main {
    flex: 1;
    width: 100%;
  }

  .site-footer {
    background: var(--background);
    color: var(--text-secondary);
    margin-top: 4rem;
    padding: 3rem 2rem;
    border-top: 1px solid var(--border);
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-size: 0.875rem;
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
  }

  .footer-links a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--text);
  }
</style>