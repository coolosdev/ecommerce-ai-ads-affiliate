---
import SEO from "../components/SEO.astro";

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  schema?: Record<string, unknown>;
}

const {
  title = "Partner Revenue Labs",
  description = "Revenue-focused guides and tools for ecommerce brands using AI in ads and analytics.",
  canonical = "https://yourdomain.com/",
  ogImage,
  schema,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f172a" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <SEO title={title} description={description} canonical={canonical} ogImage={ogImage} schema={schema} />
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="logo">
          <img src="/favicon.svg" alt="" class="logo-mark" width="40" height="40" />
          <div class="logo-text">
            <div class="logo-line">PARTNER REVENUE</div>
            <div class="logo-sub">LABS</div>
          </div>
        </a>
        <nav class="nav">
          <a href="/blog">Guides</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <p>&copy; {new Date().getFullYear()} Partner Revenue Labs. All rights reserved.</p>
        <div class="footer-links">
          <a href="/blog">Guides</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
          <a href="/media-kit">Media Kit</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  :root {
    --background: #020617;
    --surface: #0f172a;
    --surface-elev: #1e293b;
    --border: #334155;
    --border-hover: #475569;
    --text: #f1f5f9;
    --text-secondary: #94a3b8;
    --muted: #64748b;
    --primary: #0f172a;
    --secondary: #1e293b;
    --accent: #10b981;
    --accent-hover: #059669;
    --brand-red: #d42b2b;
    --radius: 0.75rem;
    --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.3);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.4);
    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.5);
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: "Archivo", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.6;
    color: var(--text);
    background: var(--background);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .site-header {
    background: rgba(2, 6, 23, 0.85);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(12px);
  }

  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.25rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .logo:hover {
    opacity: 0.85;
  }

  .logo-mark {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .logo-line {
    font-weight: 800;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
    color: var(--text);
    white-space: nowrap;
  }

  .logo-sub {
    font-weight: 600;
    font-size: 0.625rem;
    letter-spacing: 0.35em;
    color: var(--text-secondary);
    margin-top: 0.2rem;
    text-align: center;
    margin-left: 0.35em;
  }

  @media (max-width: 640px) {
    .logo-line {
      font-size: 0.95rem;
    }
    .logo-sub {
      font-size: 0.55rem;
    }
    .logo-mark {
      width: 2rem;
      height: 2rem;
    }
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav a {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav a:hover {
    color: var(--text);
  }

  main {
    flex: 1;
    width: 100%;
  }

  .site-footer {
    background: var(--background);
    color: var(--text-secondary);
    margin-top: 4rem;
    padding: 3rem 2rem;
    border-top: 1px solid var(--border);
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-size: 0.875rem;
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
  }

  .footer-links a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--text);
  }
</style>